{
  "concurrency": 3,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "auto_merge": true,
  "human_merge": { "risk": ["high"], "surfaces": [] },
  "max_cost_usd": 5.0,
  "budgets": { "clearing_ops": { "max_regression_pct": 10 } },
  "gate_timeout_seconds": 1800,
  "refuse_edits_after_label": true,
  "sweep": { "max_issues": 3 },
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low":    { "code": "haiku" },
    "medium": { "code": "sonnet" },
    "high":   { "code": "sonnet", "security": "opus" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "haiku" },
    "security": { "security": "opus" }
  },
  "surface_paths": {
    "dayahead/web.py": ["ui", "security"]
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/budget.py"
  ],
  "guarded_paths": [
    "factory/bin/*",
    "factory/checks.sh",
    "factory/config.json",
    "factory/budget.py",
    "factory/worktree-setup.sh",
    "factory/local-setup.sh",
    "fx",
    "fx.cmd",
    ".gitattributes",
    ".github/*",
    ".claude/*",
    "pyproject.toml",
    "pytest.py",
    "pytest/*",
    "_pytest/*",
    "conftest.py",
    "*/conftest.py",
    "pytest.ini",
    "tox.ini",
    "setup.cfg",
    "ruff.toml",
    ".ruff.toml"
  ],
  "ports": { "base": 5100, "step": 10 },
  "prices_usd_per_mtok": {
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-fable-5-2":  { "input": 8.0,  "output": 40.0, "cache_write_5m": 10.0, "cache_write_1h": 16.0, "cache_read": 0.20 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.10 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
