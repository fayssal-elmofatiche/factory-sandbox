  "cards": [
    {
      "dot": "emerald",
      "title": "How a job moves",
      "items": [
        "intake, spec, build, gate, review, approve, merge",
        "after every agent, factory/bin/job checks its file and moves the job, or refuses",
        "job merge syncs with main, runs the gate again and pushes main to origin.git"
      ]
    },
    {
      "dot": "rose",
      "title": "Who may write what",
      "items": [
        "each agent writes only its own file in the job folder; the builder also its worktree",
        "only factory/bin/job writes job.json and moves a job",
        "the gate runs the checks from main, so a branch cannot change what judges it"
      ]
    },
    {
      "dot": "cyan",
      "title": "Not drawn",
      "items": [
        "factory/bin/route picks reviewers from risk and config.json",
        "fx sweep, retro, bench and demo; the kata tracker"
      ]
    }
  ]
